{
  "name": "ghostpacket-clinic",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "GhostClinic: offline rural clinic records, signed prescriptions handed to the pharmacy over sound or light.",
  "license": "MIT",
  "scripts": {
    "predev": "node ../../scripts/sync-app-assets.mjs .",
    "dev": "next dev",
    "prebuild": "node ../../scripts/sync-app-assets.mjs .",
    "build": "next build && node ../../scripts/fix-next-export.mjs out",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ghostpacket-sdk": "*",
    "ghostpacket-ui": "*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
