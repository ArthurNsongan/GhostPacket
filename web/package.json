{
  "name": "ghostpacket-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GhostPacket Spectral Signal Lab: air-gapped signed data over sound (4-FSK) and light (fountain QR).",
  "license": "MIT",
  "scripts": {
    "wasm": "wasm-pack build ../crates/ghostpacket-core --target web --release --out-dir ../../web/src/wasm --out-name ghostpacket_core && node ../scripts/copy-wasm.mjs",
    "dev": "next dev",
    "build": "next build && node ../scripts/fix-next-export.mjs out",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "jsqr": "1.4.0",
    "next": "16.4.6",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
