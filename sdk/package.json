{
  "name": "ghostpacket-sdk",
  "version": "0.2.0",
  "description": "Signed offline documents over sound (4-FSK) and light (fountain QR): seal, transmit, receive, verify and sync proofs. Rust/WASM core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./wasm/ghostpacket_core_bg.wasm": "./dist/wasm/ghostpacket_core_bg.wasm",
    "./assets/capture-processor.js": "./dist/assets/capture-processor.js"
  },
  "files": ["dist", "README.md"],
  "sideEffects": ["./dist/lib/index.js"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../scripts/build-sdk.mjs",
    "test": "node --test test/sdk.test.mjs",
    "test:browser": "node test/browser.test.mjs",
    "prepack": "node ../scripts/build-sdk.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurNsongan/GhostPacket.git",
    "directory": "sdk"
  }
}
